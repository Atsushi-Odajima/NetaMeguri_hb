{
  "name": "netameguri",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "NetaMeguri — AIコンテンツ再利用・SNS運用OS (#023)",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch server/src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/src/main.ts",
    "seed": "tsx server/src/seed/run.ts",
    "mcp": "tsx server/src/mcp/stdio.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "perf": "tsx scripts/perf.ts",
    "assets": "node scripts/render-assets.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "fastify": "^5.12.5",
    "fflate": "^0.8.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.2.4",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  }
}
